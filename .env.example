# ==========================================================
# NormaCita - variables de entorno (copia este archivo a .env)
# NUNCA subas el .env real al repositorio.
# ==========================================================

# Proveedor de IA: "fake" (sin clave, respuestas extractivas para desarrollo/tests)
#                  o "openai_compatible" (cualquier API compatible con /chat/completions)
LLM_PROVIDER=fake

# Solo si LLM_PROVIDER=openai_compatible. Ejemplos de endpoints compatibles:
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (local, sin clave)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Corpus de normativa (JSON generado por scripts/ingest_boe.py)
CORPUS_PATH=data/corpus/rebt.json

# Recuperación: nº de fragmentos y puntuación mínima BM25 para considerar que hay base normativa
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=1.0

# Límite simple de peticiones por IP y minuto (protección básica contra abuso/coste)
RATE_LIMIT_PER_MINUTE=20

# Orígenes permitidos para CORS (separados por comas). Vacío = solo mismo origen.
CORS_ORIGINS=
